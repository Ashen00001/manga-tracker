# Copy to .env and fill in.

# Where "nearby" is measured from (your home by default) and how far to look
HOME_LAT=47.6062
HOME_LON=-122.3321
HOME_ZIP=98101
RADIUS_MILES=20

# Watchlist check frequency
CHECK_INTERVAL_HOURS=4

# Discord DMs (see README: "Discord bot")
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Set a password if the app is reachable from the internet (not needed behind Tailscale)
APP_PASSWORD=

# Base URL of the web app, so Discord alerts link straight to the volume
PUBLIC_URL=
